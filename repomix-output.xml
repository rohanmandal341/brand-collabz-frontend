  useEffect(() => {
    fetchTeamMembers()
      .then((res) => setMembers(res || []))
      .catch(() => {});
  }, []);

  const loadCreators = () => {
    setLoading(true);
    fetchCreatorsTable({
      search,
      niche,
      location,
      addedBy,
      followerRange,
      timeRange,
      page,
      size,
      sortBy: 'createdAt',
      sortDir: 'desc'
    })
      .then((res) => setData(res))
      .catch((err) => console.error('Creators fetch error:', err))
      .finally(() => setLoading(false));
  };

  useEffect(() => {
    loadCreators();
  }, [search, niche, location, addedBy, followerRange, timeRange, page, size]);

  const resetFilters = () => {
    setSearch('');
