                </h2>
                <dl className="mt-2 divide-y divide-[#f0e7e0] rounded-xl border border-[#eadfd6]">
                  {tiers.map((tier, i) => (
                    <div
                      key={`${tier.follower_range}-${i}`}
                      className="flex items-center justify-between gap-3 px-4 py-3"
