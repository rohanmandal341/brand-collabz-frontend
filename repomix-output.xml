<file path="src/auth/authService.js">
// One service, two modes. Pages and RoleDashboard use it the same way in both.
//
//   DEMO mode (default): accounts live in this browser's localStorage, so signup, login,
//                        onboarding and the dashboard all work today with no backend.
//   API mode:            set  VITE_AUTH_MODE=api  in your .env when the backend is ready
//                        (paths come from AUTH_ENDPOINTS in authConfig.js). No other code changes.
//
// API contract (all JSON, session via httpOnly cookie):
//   signup { name,email,password,role } -> { user }      login { email,password,remember } -> { user }
//   google { credential,role? } -> { user }              forgotPassword { email } -> 200 always
//   onboarding { role, instagram, niches, phone, country, state, city, company, ... } -> { dashboardUrl? }
//   me -> { user } or 401                                logout -> 204
//   user = { id, name, email, role, onboardingComplete }
import { AUTH_ENDPOINTS, AUTH_API_BASE } from "./authConfig";

const USE_API = import.meta.env.VITE_AUTH_MODE === "api";

/* ---------------- DEMO (localStorage). Never ship this to production. ---------------- */
const USERS_KEY = "adrovis_demo_users";
const SESSION_KEY = "adrovis_demo_session";
const read = () => { try { return JSON.parse(localStorage.getItem(USERS_KEY) || "[]"); } catch { return []; } };
const write = (u) => localStorage.setItem(USERS_KEY, JSON.stringify(u));
const norm = (e) => String(e || "").trim().toLowerCase();
const pub = ({ password, ...u }) => u;
const login = (u) => localStorage.setItem(SESSION_KEY, JSON.stringify({ id: u.id }));
const wait = (ms = 250) => new Promise((r) => setTimeout(r, ms));
const sessionUser = () => {
  try { const s = JSON.parse(localStorage.getItem(SESSION_KEY) || "null"); return s ? read().find((u) => u.id === s.id) || null : null; }
  catch { return null; }
};

const demo = {
  async signup({ name, email, password, role }) {
    await wait();
    const users = read(); const e = norm(email);
    if (users.some((u) => u.email === e)) throw new Error("An account with this email already exists. Please log in.");
    const user = { id: `demo_${Date.now()}`, name, email: e, password, role, onboardingComplete: false, profile: {} };
    write([...users, user]); login(user);
    return { user: pub(user) };
  },
  async login({ email, password }) {
    await wait();
    const user = read().find((u) => u.email === norm(email));
    if (!user) throw new Error("No account found for this email. Sign up first.");
    if (!user.password) throw new Error("This account uses Google. Use “Continue with Google”.");
    if (user.password !== password) throw new Error("Incorrect password. Try again or reset it.");
    login(user);
    return { user: pub(user) };
  },
  async google(_credential, role) {
    // Demo shortcut: does NOT talk to Google.
    await wait();
    const users = read(); const email = "google.demo@adrovis.local";
    let user = users.find((u) => u.email === email);
    if (!user) {
      user = { id: `demo_google_${Date.now()}`, name: "Google Demo User", email, role, password: null, onboardingComplete: false, profile: {} };
      write([...users, user]);
    } else if (!user.role && role) {
      user.role = role; write(users.map((u) => (u.id === user.id ? user : u)));
    }
    login(user);
    return { user: pub(user) };
  },
  async forgotPassword() { await wait(); return { accepted: true }; },
  async completeOnboarding(payload) {
    await wait();
    const me = sessionUser();
    if (!me) throw new Error("Your session has expired. Please log in again.");
    const users = read();
    const updated = { ...me, role: payload.role || me.role, profile: { ...me.profile, ...payload }, onboardingComplete: true };
    write(users.map((u) => (u.id === me.id ? updated : u)));
    return { user: pub(updated), dashboardUrl: `/dashboard/${updated.role}` };
  },
  async currentUser() { const u = sessionUser(); return u ? pub(u) : null; },
  logout() { localStorage.removeItem(SESSION_KEY); },
};

/* ---------------- API ---------------- */
async function request(path, { method = "GET", body } = {}) {
  let res;
  try {
    res = await fetch(`${AUTH_API_BASE}${path}`, {
      method, credentials: "include",
      headers: body ? { "Content-Type": "application/json" } : undefined,
      body: body ? JSON.stringify(body) : undefined,
    });
  } catch { throw new Error("Can’t reach the server. Check your connection and try again."); }
  const json = await res.json().catch(() => null);
  if (!res.ok) { const err = new Error(json?.message || json?.error || "Something went wrong. Please try again."); err.status = res.status; throw err; }
  return json;
}
const api = {
  signup: (p) => request(AUTH_ENDPOINTS.signup, { method: "POST", body: p }),
  login: (p) => request(AUTH_ENDPOINTS.login, { method: "POST", body: p }),
  google: (credential, role) => request(AUTH_ENDPOINTS.google, { method: "POST", body: { credential, role } }),
  forgotPassword: (email) => request(AUTH_ENDPOINTS.forgotPassword, { method: "POST", body: { email } }),
  completeOnboarding: (p) => request(AUTH_ENDPOINTS.onboarding, { method: "POST", body: p }),
  async currentUser() { try { return (await request(AUTH_ENDPOINTS.me))?.user || null; } catch (e) { if (e.status === 401) return null; throw e; } },
  logout: () => request(AUTH_ENDPOINTS.logout || "/api/auth/logout", { method: "POST" }).catch(() => null),
};

export const authService = USE_API ? api : demo;
</file>

