<file path="src/components/campaign/CampaignCard.jsx">
import React, { useEffect, useMemo, useRef, useState } from "react";
import { Link } from "react-router-dom";
import {
  ArrowUpRight,
  MapPin,
  Wallet,
  Gift,
  Users,
} from "lucide-react";

import { payoutLabel } from "../../utils/format";
import {
  brandStyle as getBrandStyle,
  getApplyUrl,
  getStatus,
  uniqueStrings,
} from "../../utils/campaign";

const ROTATE_MS = 5000;

const getAudience = (campaign) => {
  const eligibility = campaign?.eligibility;

  return (
    eligibility?.minimum_followers_display ||
    (eligibility?.minimum_followers
      ? `${Number(eligibility.minimum_followers).toLocaleString("en-IN")}+ followers`
      : "Open to all")
  );
};

const preload = (src) =>
  new Promise((resolve) => {
    const img = new Image();
    img.onload = () => resolve(true);
    img.onerror = () => resolve(false);
    img.src = src;
  });

const CampaignCard = ({ campaign }) => {
  const [failed, setFailed] = useState(() => new Set());
  const [activeSrc, setActiveSrc] = useState(null);
  const [prevSrc, setPrevSrc] = useState(null);
  const [seen, setSeen] = useState(() => new Set());

  const images = useMemo(
    () => uniqueStrings(campaign?.images).filter((src) => !failed.has(src)),
    [campaign?.images, failed]
  );

  // Fall back to the first image if the active one was removed or not set yet.
  const current = images.includes(activeSrc) ? activeSrc : images[0];
  const currentRef = useRef(current);
  currentRef.current = current;

  const brand = campaign?.brandName || "Brand";
  const isPaid = campaign?.campaignType?.toUpperCase() === "PAID";
  const brandStyle = getBrandStyle ? getBrandStyle(brand) : { bg: "#2563eb", color: "#ffffff" };
  const status = getStatus ? getStatus(campaign) : { closed: false };

  const brandLogo =
    campaign?.brandLogo ||
    campaign?.brand_logo ||
    campaign?.logoUrl ||
    campaign?.logo ||
    campaign?.brand?.logo;

  const location = campaign?.eligibility?.locations?.length
    ? campaign.eligibility.locations.join(", ")
    : "India";

  const reward = payoutLabel(campaign);

  // Robust apply link resolver with external/internal URL support
  const applyLink = useMemo(() => {
    try {
      if (typeof getApplyUrl === "function") {
        const url = getApplyUrl(campaign);
        if (url && url !== "#" && url !== "undefined") return url;
      }
    } catch (_) {}
    return (
      campaign?.applyProxyUrl ||
      campaign?.applyUrl ||
      campaign?.apply_url ||
      campaign?.formUrl ||
      `/campaigns/${campaign?.id}`
    );
  }, [campaign]);

  const isExternal =
    applyLink.startsWith("http://") || applyLink.startsWith("https://");

  // Reset the slideshow when the card shows a different campaign.
  useEffect(() => {
    setActiveSrc(null);
    setPrevSrc(null);
    setSeen(new Set());
    setFailed(new Set());
  }, [campaign?.id]);

  // Warm the cache for the next image as soon as the current one is showing
  useEffect(() => {
    if (images.length < 2 || !current) return;
    preload(images[(images.indexOf(current) + 1) % images.length]);
  }, [current, images]);

  // Rotate images every 5 seconds with preloaded cross-fade
  useEffect(() => {
    if (images.length < 2) return undefined;

    let cancelled = false;
    let swapTimer;

    const timer = setInterval(async () => {
      if (document.hidden) return;

      const shown = currentRef.current;
      const next = images[(images.indexOf(shown) + 1) % images.length];
      if (!next || next === shown) return;

      const ok = await preload(next);
      if (cancelled) return;

      if (!ok) {
        setFailed((prev) => new Set(prev).add(next));
        return;
      }

      setSeen((prev) => new Set(prev).add(next));
      swapTimer = setTimeout(() => {
        if (cancelled) return;
        setPrevSrc(shown);
        setActiveSrc(next);
      }, 40);
    }, ROTATE_MS);

    return () => {
      cancelled = true;
      clearInterval(timer);
      clearTimeout(swapTimer);
    };
  }, [campaign?.id, images]);

  if (!campaign) return null;

  const activeIndex = Math.max(0, images.indexOf(current));
  const layers = images.filter(
    (src) => src === current || src === prevSrc || seen.has(src)
  );

  return (
    <article className="group flex h-full min-w-0 flex-col overflow-hidden rounded-[20px] border border-slate-200/90 bg-white shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-slate-300 hover:shadow-lg">

      {/* Campaign image header */}
      <div className="relative h-[185px] shrink-0 overflow-hidden bg-slate-100 sm:h-[195px] lg:h-[205px]">
        {images.length > 0 ? (
          layers.map((src) => {
            const isActive = src === current;
            const isPrev = src === prevSrc;

            return (
              <img
                key={src}
                src={src}
                alt={isActive ? `${brand} campaign` : ""}
                aria-hidden={!isActive}
                loading={isActive ? "lazy" : undefined}
                decoding="async"
                onError={() =>
                  setFailed((prev) => new Set(prev).add(src))
                }
                className={`
                  absolute inset-0 h-full w-full object-cover object-center
                  transition-[opacity,transform] duration-700
                  group-hover:scale-[1.04]
                  ${
                    isActive
                      ? "z-10 opacity-100"
                      : isPrev
                      ? "z-[5] opacity-100"
                      : "z-0 opacity-0"
                  }
                `}
              />
            );
          })
        ) : (
          <div className="flex h-full items-center justify-center">
            <span
              className="grid h-16 w-16 place-items-center rounded-2xl text-2xl font-bold"
              style={{
                backgroundColor: brandStyle.bg || "#2563eb",
                color: brandStyle.color || "#ffffff",
              }}
            >
              {brand.charAt(0).toUpperCase()}
            </span>
          </div>
        )}

        <div className="absolute inset-0 z-20 bg-gradient-to-t from-slate-950/70 via-slate-950/10 to-transparent" />

        {/* Brand identity */}
        <div className="absolute bottom-4 left-4 z-20 flex max-w-[75%] items-center gap-2.5">
          <span
            className="grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-full border-2 border-white bg-white text-sm font-bold shadow-xs"
            style={{ color: brandStyle.color }}
          >
            {brandLogo ? (
              <img
                src={brandLogo}
                alt={`${brand} logo`}
                className="h-full w-full object-contain p-1"
              />
            ) : (
