          {status?.closed ? (
            <span
              aria-disabled="true"
              className="flex h-10 flex-1 cursor-not-allowed items-center justify-center rounded-xl bg-slate-100 text-[12px] font-bold text-slate-400"
            >
              Closed
            </span>
          ) : isExternal ? (
            <a
              href={applyLink}
              target="_blank"
              rel="noopener noreferrer"
              className="flex h-10 flex-1 items-center justify-center gap-1.5 rounded-xl bg-blue-600 text-[12px] font-bold text-white shadow-xs transition hover:bg-blue-700"
            >
              Apply now
              <ArrowUpRight size={14} />
