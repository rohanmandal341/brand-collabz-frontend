            <Link
              to={applyLink}
              className="flex h-10 flex-1 items-center justify-center gap-1.5 rounded-xl bg-blue-600 text-[12px] font-bold text-white shadow-xs transition hover:bg-blue-700"
            >
              Apply now
              <ArrowUpRight size={14} />
            </Link>
          )}
        </div>
      </div>
    </article>
  );
};

