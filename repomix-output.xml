          <Link
            to={`/campaigns/${campaign.id}`}
            className="flex h-10 flex-1 items-center justify-center gap-1.5 rounded-xl border border-slate-300 bg-white text-[12px] font-bold text-slate-700 shadow-2xs transition hover:bg-slate-50 hover:border-slate-400"
          >
            View brief
            <ArrowUpRight size={14} />
