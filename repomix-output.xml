          />

          <div className="grid grid-cols-3 gap-3 mt-5">
            {[
              { label: 'Collected', value: trendStats ? trendStats.sum.toLocaleString() : '—' },
              { label: 'Daily average', value: trendStats ? trendStats.avg : '—' },
